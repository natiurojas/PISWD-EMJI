[gd_scene format=3 uid="uid://b8g22800r8cs3"]

[sub_resource type="GDScript" id="GDScript_fyk51"]
script/source = "extends Control

var socket := WebSocketPeer.new()

var server_ip := \"\"
var connected := false

var shoot := false
var shield := false
var boost := false

var send_timer := 0.0
var joystick_direction := Vector2.ZERO

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	$Label2.visible = false

func connect_to_server():
	server_ip = $TextEdit.text
	var error = socket.connect_to_url(\"%s\" % server_ip)
	if error != OK:
		print(\"Error al conectar: \", error)
		$Label2.text = \"ERROR AL CONECTAR: \" + str(error)
		$Label2.add_theme_color_override(\"font_color\", Color.RED)
		$Label2.visible = true
		connected = false
	else:
		$Label2.text = \"CONECTADO\"
		$Label2.add_theme_color_override(\"font_color\", Color.GREEN)
		$Label2.visible = true
		connected = true

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if not connected:
		return
	socket.poll()
	if socket.get_ready_state() == WebSocketPeer.STATE_OPEN:
		send_timer += delta
		if send_timer >= 0.05:
			send_timer = 0.0
			send_controls()

func send_controls():
	var data = {
		\"type\": \"input\",
		\"movement\": {
			\"x\": joystick_direction.x,
			\"y\": joystick_direction.y,
		},
		\"shoot\": shoot,
		\"shield\": shield,
		\"boost\": false
	}
	socket.send_text(JSON.stringify(data))


func _on_button_pressed() -> void:
	connect_to_server()

func _on_joy_stick_on_update_joystick(direction: Vector2) -> void:
	joystick_direction = direction

func _on_joy_stick_on_stop_motion() -> void:
	joystick_direction = Vector2.ZERO

func _on_button_button_down() -> void:
	shoot = true

func _on_button_button_up() -> void:
	shoot = false

func _on_button_2_button_down() -> void:
	shield = true

func _on_button_2_button_up() -> void:
	shield = false
"

